# HALO — variables d'environnement (AUCUNE valeur secrète dans le dépôt).
# Sans les deux premières variables, l'application reste en mode démo (données dans le navigateur).

# Projet Supabase (préproduction : « halo-test », région Paris / eu-west-3)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# preprod | production — affiché en permanence dans l'interface
NEXT_PUBLIC_HALO_ENV=preprod

# SECRET, serveur uniquement (jamais préfixé NEXT_PUBLIC_) : sert à la file d'envoi des e-mails
SUPABASE_SERVICE_ROLE_KEY=

# Envoi des e-mails voyageurs. Vide = aucun envoi : l'état « non envoyé » est affiché, jamais « envoyé ».
# Exemple : smtps://utilisateur:motdepasse@smtp.fournisseur.eu:465
SMTP_URL=
# … ou, plus simple à saisir (ex. Brevo) :
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
# SECRET
SMTP_PASS=
EMAIL_FROM=HALO <no-reply@votre-domaine.fr>
